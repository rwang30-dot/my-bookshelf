# Notion API Credentials
# Get your integration token from https://www.notion.so/profile/integrations
NOTION_API_KEY=ntn_your_internal_integration_secret

# Get your Database ID from your Notion database URL:
# e.g., https://www.notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your_32_character_database_id

# Optional Port
PORT=5173
